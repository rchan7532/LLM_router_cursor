# Required - your two upstream keys
# Default key: glm-5.3-flash, glm-5.3, kimi-k2.7-code, claude-haiku-4-5, kimi-k3 (direct)
ROUTER_KEY_DEFAULT=your-default-key-here
# Basic key: qwen3-vl-flash, qwen3.8-flash, glm-5.3, deepseek-v4.1-flash, qwen3.8-max (direct)
ROUTER_KEY_BASIC=your-basic-key-here

# Required - OpenAI-compatible base URLs for each key's provider
# (no trailing slash; probe them with the /models command in DEPLOY.md Step 4)
ROUTER_KEY_DEFAULT_BASE=https://your-default-provider.example.com/v1
ROUTER_KEY_BASIC_BASE=https://your-basic-provider.example.com/v1

# Required - the key Cursor sends to the proxy. A public URL without this is
# open to the internet. Generate one:
#   openssl rand -hex 24
LITELLM_MASTER_KEY=sk-local-change-me

# Required for the control service - its OWN auth, beyond the nginx path
# token. Distinct from LITELLM_MASTER_KEY so a leaked MCP config cannot be
# replayed against /v1 for completions. Generate it the same way:
#   openssl rand -hex 24
# Without it the control service refuses every write (fail closed).
CONTROL_TOKEN=control-change-me

# Optional - policy plugin tuning (defaults in routing_policy.py)
# POLICY_LOG=/app/logs/routing.jsonl
# POLICY_W_COST=0.35
# POLICY_W_TRUST=0.30
# POLICY_DISABLE=1

# Learning kill-switch. Precedence (m2): POLICY_DISABLE=1 wins over
# everything; then POLICY_LEARN=0; then control.json learning.enabled=false.
# The env switches are the hard kill - the control toggle is for daily use.
# POLICY_LEARN=0
